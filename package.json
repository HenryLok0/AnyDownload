{
  "name": "anydownload",
  "version": "2.0.0",
  "description": "A powerful website downloader with GUI support",
  "repository": "https://github.com/HenryLok0/AnyDownload.git",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "main": "web-gui.js",
  "exports": {
    ".": "./web-gui.js",
    "./downloader": "./src/downloader/index.js",
    "./engine": "./src/engine/index.js"
  },
  "bin": {
    "anydownload": "./bin/cli.js"
  },
  "scripts": {
    "start": "node web-gui.js",
    "test": "jest --config jest.config.js",
    "verify:package": "node scripts/verify-package-json.js",
    "prepublishOnly": "npm run verify:package && npm test"
  },
  "keywords": [
    "website",
    "downloader",
    "crawler",
    "scraper",
    "gui"
  ],
  "author": "HenryLok0",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.7",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^12.0.0",
    "cosmiconfig": "^8.3.0",
    "ejs": "^3.1.9",
    "express": "^5.0.0-beta.2",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.14",
    "mime-types": "^2.1.35",
    "ora": "^8.0.1",
    "playwright": "^1.42.1",
    "puppeteer": "^22.0.0",
    "sitemap": "^7.1.1",
    "socket.io": "^4.7.4",
    "undici": "^6.6.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
