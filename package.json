{
  "name": "anydownload",
  "version": "2.3.8",
  "description": "A powerful website downloader with GUI support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryLok0/AnyDownload.git"
  },
  "bugs": {
    "url": "https://github.com/HenryLok0/AnyDownload/issues"
  },
  "homepage": "https://github.com/HenryLok0/AnyDownload#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "web-gui.js",
  "files": [
    "bin/",
    "src/",
    "data/",
    "scripts/generate-path-wordlist.js",
    "scripts/install-playwright-browser.js",
    "views/",
    "public/",
    "web-gui.js",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./web-gui.js",
    "./downloader": "./src/downloader/index.js",
    "./engine": "./src/engine/index.js"
  },
  "bin": {
    "anydownload": "bin/cli.js"
  },
  "scripts": {
    "start": "node web-gui.js",
    "test": "jest --config jest.config.js",
    "generate-path-wordlist": "node scripts/generate-path-wordlist.js",
    "postinstall": "node scripts/install-playwright-browser.js",
    "verify:package": "node scripts/verify-package-json.js",
    "prepublishOnly": "npm run verify:package && npm test",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron electron-main.js\"",
    "electron:start": "vite build && electron electron-main.js",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:all": "vite build && electron-builder"
  },
  "keywords": [
    "website",
    "downloader",
    "crawler",
    "scraper",
    "gui"
  ],
  "author": {
    "name": "HenryLok0",
    "email": "mail@henrylok.me"
  },
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.6.7",
    "cheerio": "^1.0.0-rc.12",
    "clsx": "^2.1.1",
    "commander": "^12.0.0",
    "cosmiconfig": "^8.3.0",
    "ejs": "^3.1.9",
    "express": "^5.0.0-beta.2",
    "fs-extra": "^11.2.0",
    "i18next": "^26.2.0",
    "inquirer": "^9.2.14",
    "lucide-react": "^1.16.0",
    "mime-types": "^2.1.35",
    "ora": "^8.0.1",
    "playwright": "^1.42.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "sitemap": "^7.1.1",
    "socket.io": "^4.7.4",
    "tailwind-merge": "^3.6.0",
    "undici": "^6.6.2"
  },
  "peerDependencies": {
    "puppeteer": ">=22.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "jest": "^29.7.0",
    "postcss": "^8.5.14",
    "puppeteer": "^22.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.anydownload.app",
    "productName": "AnyDownload",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "src/core/**/*",
      "src/engine/**/*",
      "src/downloader/**/*",
      "src/discovery/**/*",
      "src/utils/**/*",
      "src/cli/**/*",
      "data/**/*",
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  }
}
