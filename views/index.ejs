<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AnyDownload</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container d-flex justify-content-between align-items-center w-100">
      <a class="navbar-brand" href="#"><i class="bi bi-cloud-download"></i> AnyDownload</a>
      <div>
        <button id="languageToggle" class="btn btn-outline-light btn-sm me-2" type="button">
          <i class="bi bi-translate"></i> <span id="currentLang">中文</span>
        </button>
        <button id="darkModeToggle" class="btn btn-outline-light btn-sm" type="button">
          <i class="bi bi-moon-fill"></i>
        </button>
      </div>
    </div>
  </nav>

  <div class="container main-container py-4">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card">
          <div class="card-header">
            <h4 class="mb-0" data-i18n="title">下載網站</h4>
          </div>
          <div class="card-body">
            <form id="downloadForm">
              <div class="mb-3">
                <label class="form-label" data-i18n="url">網站網址</label>
                <input type="url" class="form-control" id="url" name="url" required placeholder="https://example.com">
              </div>

              <div class="mb-3">
                <label class="form-label" data-i18n="output">輸出資料夾</label>
                <input type="text" class="form-control" id="output" name="output" value="downloaded_site">
              </div>

              <div class="mb-3">
                <label class="form-label" data-i18n="preset">下載模式</label>
                <select class="form-select" id="preset" name="preset">
                  <option value="page" data-i18n="presetPage">單頁 + 全部資源（預設）</option>
                  <option value="full" data-i18n="presetFull">完整站點（深度 2）</option>
                  <option value="mirror" data-i18n="presetMirror">鏡像模式（深度 5）</option>
                </select>
              </div>

              <div class="accordion mb-3" id="advancedAccordion">
                <div class="accordion-item">
                  <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#advancedPanel">
                      <span data-i18n="advanced">進階選項</span>
                    </button>
                  </h2>
                  <div id="advancedPanel" class="accordion-collapse collapse" data-bs-parent="#advancedAccordion">
                    <div class="accordion-body">
                      <div class="row g-3">
                        <div class="col-md-6">
                          <label class="form-label" data-i18n="engineMode">引擎模式</label>
                          <select class="form-select" id="mode" name="mode">
                            <option value="auto" selected>auto（自動）</option>
                            <option value="static">static（靜態）</option>
                            <option value="render">render（瀏覽器）</option>
                          </select>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" data-i18n="resourceType">資源類型</label>
                          <select class="form-select" id="type" name="type">
                            <option value="all" selected>全部格式</option>
                            <option value="image">僅圖片</option>
                            <option value="css">僅 CSS</option>
                            <option value="js">僅 JS</option>
                            <option value="html">僅 HTML</option>
                            <option value="media">僅媒體</option>
                            <option value="font">僅字型</option>
                          </select>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" data-i18n="browser">瀏覽器引擎</label>
                          <select class="form-select" id="browser" name="browser">
                            <option value="playwright" selected>Playwright</option>
                            <option value="puppeteer">Puppeteer</option>
                          </select>
                          <div class="form-text">Playwright is bundled; first install downloads Chromium automatically.</div>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" data-i18n="depth">遞迴深度</label>
                          <input type="number" class="form-control" id="maxDepth" name="maxDepth" min="1" max="10" value="1">
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" data-i18n="concurrency">並發數</label>
                          <input type="number" class="form-control" id="concurrency" name="concurrency" value="5" min="1" max="20">
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" data-i18n="wait">載入等待 (ms)</label>
                          <input type="number" class="form-control" id="wait" name="wait" value="2000">
                        </div>
                        <div class="col-12">
                          <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="dynamic" name="dynamic">
                            <label class="form-check-label" for="dynamic" data-i18n="forceDynamic">強制動態模式</label>
                          </div>
                          <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="sitemap" name="sitemap">
                            <label class="form-check-label" for="sitemap" data-i18n="sitemap">使用 Sitemap</label>
                          </div>
                          <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="ignoreRobots" name="ignoreRobots">
                            <label class="form-check-label" for="ignoreRobots" data-i18n="ignoreRobots">忽略 robots.txt</label>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="accordion-item">
                  <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#expertPanel">
                      <span data-i18n="expert">專家選項</span>
                    </button>
                  </h2>
                  <div id="expertPanel" class="accordion-collapse collapse" data-bs-parent="#advancedAccordion">
                    <div class="accordion-body">
                      <div class="mb-3">
                        <label class="form-label" data-i18n="proxy">Proxy</label>
                        <input type="text" class="form-control" id="proxy" name="proxy" placeholder="http://127.0.0.1:8080">
                      </div>
                      <div class="mb-3">
                        <label class="form-label" data-i18n="filter">URL 正則過濾</label>
                        <input type="text" class="form-control" id="filter" name="filter" placeholder="\.css$">
                      </div>
                      <div class="mb-3">
                        <label class="form-label" data-i18n="loginForm">登入表單 JSON</label>
                        <textarea class="form-control" id="loginForm" name="loginForm" rows="2" placeholder='{"#email":"email","#pass":"password"}'></textarea>
                      </div>
                      <div class="mb-3">
                        <label class="form-label" data-i18n="loginCredentials">登入憑證 JSON</label>
                        <textarea class="form-control" id="loginCredentials" name="loginCredentials" rows="2" placeholder='{"email":"user@x.com","password":"secret"}'></textarea>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <button type="submit" class="btn btn-primary w-100" id="submitBtn">
                <i class="bi bi-download"></i> <span data-i18n="start">開始下載</span>
              </button>
            </form>

            <div id="status" class="mt-4" style="display:none;">
              <label class="form-label" data-i18n="progress">下載進度</label>
              <div class="progress mb-2">
                <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width:0%"></div>
              </div>
              <small id="currentFile" class="text-muted d-block"></small>
              <small id="progressMeta" class="text-muted d-block mt-1 font-monospace"></small>
              <div id="actionButtons" class="mt-3" style="display:none;">
                <button type="button" class="btn btn-outline-secondary me-2" id="btnOpenFolder">
                  <i class="bi bi-folder2-open"></i> <span data-i18n="openFolder">開啟資料夾</span>
                </button>
                <button type="button" class="btn btn-outline-primary" id="btnOpenWebsite">
                  <i class="bi bi-globe"></i> <span data-i18n="openSite">開啟離線首頁</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const translations = {
      'zh-TW': {
        title: '下載網站', url: '網站網址', output: '輸出資料夾', preset: '下載模式',
        presetPage: '單頁 + 全部資源（預設）', presetFull: '完整站點（深度 2）', presetMirror: '鏡像模式（深度 5）',
        advanced: '進階選項', expert: '專家選項', engineMode: '引擎模式', resourceType: '資源類型',
        browser: '瀏覽器引擎', depth: '遞迴深度',
        concurrency: '並發數', wait: '載入等待 (ms)', forceDynamic: '強制動態模式',
        sitemap: '使用 Sitemap', ignoreRobots: '忽略 robots.txt', proxy: 'Proxy',
        filter: 'URL 正則過濾', loginForm: '登入表單 JSON', loginCredentials: '登入憑證 JSON',
        start: '開始下載', progress: '下載進度', openFolder: '開啟資料夾', openSite: '開啟離線首頁',
        downloading: '下載中...', complete: '下載完成', error: '錯誤：',
        elapsed: '已執行', eta: '預估剩餘'
      },
      en: {
        title: 'Download Website', url: 'Website URL', output: 'Output folder', preset: 'Mode',
        presetPage: 'Single page + assets', presetFull: 'Full site (depth 2)', presetMirror: 'Mirror (depth 5)',
        advanced: 'Advanced', expert: 'Expert', engineMode: 'Engine mode', resourceType: 'Resource type',
        browser: 'Browser engine', depth: 'Max depth',
        concurrency: 'Concurrency', wait: 'Extra wait (ms)', forceDynamic: 'Force dynamic mode',
        sitemap: 'Use sitemap', ignoreRobots: 'Ignore robots.txt', proxy: 'Proxy',
        filter: 'URL regex filter', loginForm: 'Login form JSON', loginCredentials: 'Login credentials JSON',
        start: 'Start download', progress: 'Progress', openFolder: 'Open folder', openSite: 'Open offline site',
        downloading: 'Downloading...', complete: 'Complete', error: 'Error: ',
        elapsed: 'Elapsed', eta: 'ETA ~'
      }
    };

    let currentLang = localStorage.getItem('anydownload-lang') || 'zh-TW';
    let currentDownloadFolder = null;
    const socket = io();

    function setLanguage(lang) {
      currentLang = lang;
      localStorage.setItem('anydownload-lang', lang);
      document.documentElement.lang = lang;
      document.getElementById('currentLang').textContent = lang === 'zh-TW' ? '中文' : 'English';
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (translations[lang][key]) el.textContent = translations[lang][key];
      });
    }

    document.getElementById('languageToggle').addEventListener('click', () => {
      setLanguage(currentLang === 'zh-TW' ? 'en' : 'zh-TW');
    });

    document.getElementById('darkModeToggle').addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      localStorage.setItem('anydownload-dark', document.body.classList.contains('dark-mode'));
    });

    if (localStorage.getItem('anydownload-dark') === 'true') {
      document.body.classList.add('dark-mode');
    }
    setLanguage(currentLang);

    document.getElementById('preset').addEventListener('change', (e) => {
      const map = { page: 1, full: 2, mirror: 5 };
      document.getElementById('maxDepth').value = map[e.target.value] || 1;
    });

    const form = document.getElementById('downloadForm');
    const status = document.getElementById('status');
    const progressBar = document.getElementById('progressBar');
    const currentFile = document.getElementById('currentFile');
    const progressMeta = document.getElementById('progressMeta');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries(fd.entries());
      data.dynamic = document.getElementById('dynamic').checked;
      data.sitemap = document.getElementById('sitemap').checked;
      data.ignoreRobots = document.getElementById('ignoreRobots').checked;

      status.style.display = 'block';
      progressBar.style.width = '0%';
      progressMeta.textContent = '';
      progressBar.classList.add('progress-bar-striped', 'progress-bar-animated');
      progressBar.classList.remove('bg-success', 'bg-danger');
      document.getElementById('actionButtons').style.display = 'none';

      const btn = document.getElementById('submitBtn');
      btn.disabled = true;

      try {
        const res = await fetch('/api/download', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (!result.success) throw new Error(result.error);
        currentDownloadFolder = result.folder;
        document.getElementById('actionButtons').style.display = 'block';
        progressBar.style.width = '100%';
        currentFile.textContent = translations[currentLang].complete;
        progressMeta.textContent = '';
        progressBar.classList.add('bg-success');
      } catch (err) {
        currentFile.textContent = translations[currentLang].error + err.message;
        progressBar.classList.add('bg-danger');
      } finally {
        btn.disabled = false;
      }
    });

    socket.on('download-progress', (d) => {
      const pct = d.percent != null ? Math.min(100, d.percent) : (d.total ? Math.round((d.current / d.total) * 100) : 0);
      progressBar.style.width = pct + '%';
      currentFile.textContent = d.detailShort || d.file || '';
      const metaParts = [];
      if (d.elapsedFormatted) metaParts.push(`${translations[currentLang].elapsed || 'Elapsed'} ${d.elapsedFormatted}`);
      if (d.etaFormatted) metaParts.push(`${translations[currentLang].eta || 'ETA ~'} ${d.etaFormatted}`);
      if (d.speed) metaParts.push(d.speed);
      if (d.phase) metaParts.push(d.phase);
      progressMeta.textContent = metaParts.filter(Boolean).join(' · ');
    });

    socket.on('download-complete', () => {
      progressBar.style.width = '100%';
      currentFile.textContent = translations[currentLang].complete;
      progressMeta.textContent = '';
    });

    document.getElementById('btnOpenFolder').addEventListener('click', async () => {
      await fetch('/api/open-folder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ folder: currentDownloadFolder })
      });
    });

    document.getElementById('btnOpenWebsite').addEventListener('click', async () => {
      await fetch('/api/open-website', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ folder: currentDownloadFolder })
      });
    });
  </script>
</body>
</html>
